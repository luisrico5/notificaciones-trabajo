# Base de calibración DPCTrack2 y binarios del programa — NO publicar (contienen datos y la clave).
20260810_dpctrack2_backup.mdb
*.mdb
zzz/

# PDFs de referencia (informes DPCTrack de ejemplo) — material de entrada, no del entregable.
*.pdf

# JSON que descarga el botón "Grabar a la base de datos" (entrada para grabar_reporte.ps1) — datos de planta.
grabar_*.json

# Lanzador local para arrastrar el JSON y grabar — lleva la clave de la base, NO publicar.
*.bat

# Los rangos ya quedan incrustados en index.html; la base no se necesita para el sitio.

# Supabase: variables de entorno locales y temporales de la CLI (la anon key es publica; la service_role NUNCA va al repo).
.env*
supabase/.temp/
