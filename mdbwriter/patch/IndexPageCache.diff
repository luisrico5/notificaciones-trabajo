   /**
+   * PARCHE: índice de la (única) entrada del padre que apunta a la página
+   * hija dada, o -1 si no hay exactamente una.
+   */
+  private static int findEntryBySubPage(DataPageExtra parentExtra,
+                                        Integer childPageNumber)
+  {
+    int found = -1;
+    int size = parentExtra._entryView.size();
+    for(int i = 0; i < size; ++i) {
+      Entry e = parentExtra._entryView.get(i);
+      if(e.isLeafEntry()) {
+        return -1;
+      }
+      Integer sub = e.getSubPageNumber();
+      if((sub != null) && sub.equals(childPageNumber)) {
+        if(found >= 0) {
+          return -1;
+        }
+        found = i;
+      }
+    }
+    return found;
+  }
